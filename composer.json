{
  "name": "jbtronics/settings-bundle",
  "type": "symfony-bundle",
  "license": "MIT",
  "description": "A symfony bundle to easily create typesafe, user-configurable settings for symfony applications",
  "keywords": ["settings", "config", "symfony", "symfony-bundle", "user-configurable", "configuration", "dynamic-settings", "user-config", "options", "preferences"],
  "autoload": {
    "psr-4": {
      "Jbtronics\\SettingsBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jbtronics\\SettingsBundle\\Tests\\TestApplication\\": "tests/TestApplication/src/",
      "Jbtronics\\SettingsBundle\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Jan Böhmer",
      "email": "mail@jan-boehmer.de",
      "role": "Maintainer"
    },
    {
      "name": "Github Contributors",
      "homepage": "https://github.com/jbtronics/settings-bundle/graphs/contributors"
    }
  ],
  "suggest": {
    "symfony/twig-bridge": "Allows to access settings in twig templates",
    "doctrine/doctrine-bundle": "To use the doctrine ORM storage",
    "symfony/yaml": "To use the YAML metadata driver for settings configuration"
  },
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "symfony/framework-bundle": "^7.4|^8.0",
    "symfony/translation-contracts": "^2.5|^3.0",
    "symfony/validator": "^7.4|^8.0",
    "symfony/form": "^7.4|^8.0",
    "symfony/var-exporter": "^7.4|^8.0",
    "ergebnis/classy": "^1.6|^2.0|^3.0",
    "symfony/translation": "^7.4|^8.0",
    "symfony/type-info": "^7.4|^8.0",
    "symfony/deprecation-contracts": "^3.4"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "symfony/phpunit-bridge": "^7.4|^8.0",
    "phpunit/phpunit": "^9.5",
    "symfony/security-csrf": "^7.4|^8.0",
    "phpstan/phpstan": "^2.0",
    "ekino/phpstan-banned-code": "^3.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/extension-installer": "^1.3",
    "symfony/twig-bridge": "^7.4|^8.0",
    "symfony/console": "^7.4|^8.0",
    "phpstan/phpstan-symfony": "^2.0",
    "doctrine/doctrine-bundle": "^2.11",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-fixtures-bundle": "^3.5",
    "symfony/yaml": "^7.4|^8.0",
    "symfony/twig-bundle": "^7.4|^8.0",
    "symfony/web-profiler-bundle": "^7.4|^8.0",
    "symfony/browser-kit": "^7.4|^8.0",
    "symfony/debug-bundle": "^7.4|^8.0",
    "symfony/css-selector": "^7.4|^8.0"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
